<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Calls and exits as notifications. Asked for once, on first start, from Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wake just after each daily close. USE_EXACT_ALARM is left out on purpose: it is reserved for alarm and calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Arm the daily alarm again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Offer to be exempted from battery optimisation, so Samsung does not put the daily pass to sleep. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Hand a downloaded update to Android's installer (which still asks the user before it installs anything). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The analyst can hand a question to the Claude app; from Android 11 an app must name the apps it looks for. -->
    <queries>
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:name=".SignalLabApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Signal Lab"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignalLab">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.SignalLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the installer read the downloaded update from the app's cache, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- The daily-close alarm, and arming it again after a reboot or an update. -->
        <receiver
            android:name=".runner.DailyCloseReceiver"
            android:exported="false" />

        <receiver
            android:name=".runner.V2BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
