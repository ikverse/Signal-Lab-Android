<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Alerts. Asked for at run time from Android 13, after the first list is switched on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The service that keeps scanning alive between candle closes (type "special use"; see ScanService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Wake exactly when a candle closes. USE_EXACT_ALARM is left out on purpose: it is reserved for alarm and calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Start scanning again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Keep the CPU on for the length of a scan. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Offer to be exempted from battery optimisation, so overnight scans are not cut short. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Hand a downloaded update to Android's installer (which still asks the user before it installs anything). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".SignalLabApplication"
        android:allowBackup="false"
        android:label="Signal Lab"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignalLab">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.SignalLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the installer read the downloaded update from the app's cache, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name=".scan.ScanService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Wakes at each candle close to scan the coins the user watches and record paper trades" />
        </service>

        <receiver
            android:name=".scan.ScanAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".scan.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
