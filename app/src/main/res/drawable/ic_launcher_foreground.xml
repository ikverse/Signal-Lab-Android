        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="25.2"
        android:translateY="26.4">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF5B8DFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M3,17 L9,11 L13,15 L21,6" />
        <path
            android:fillColor="#00000000"
